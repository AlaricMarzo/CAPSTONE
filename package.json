{
  "name": "capstone-monorepo",
  "version": "1.0.0",
  "private": true,
  "main": "backend/src/server.js",
  "description": "Full-stack capstone project with React frontend and Node.js backend",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:frontend": "cd frontend && npm ci && npm run build",
    "build:backend": "cd backend && npm run build",
    "build": "npm run build:frontend",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && npm install",
    "install:all": "npm run install:frontend && npm run install:backend",
    "clean": "rm -rf frontend/node_modules backend/node_modules frontend/dist backend/dist",
    "heroku-postbuild": "npm run build",
    "start": "cd backend && npm install && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "form-data": "^4.0.4",
    "react-router-dom": "^6.30.1"
  }
}
