{
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "envVars": [
      {
        "name": "DATABASE_URL",
        "fromSecret": "DATABASE_URL"
      },
      {
        "name": "VITE_FIREBASE_API_KEY",
        "fromSecret": "VITE_FIREBASE_API_KEY"
      },
      {
        "name": "VITE_FIREBASE_AUTH_DOMAIN",
        "fromSecret": "VITE_FIREBASE_AUTH_DOMAIN"
      },
      {
        "name": "VITE_FIREBASE_PROJECT_ID",
        "fromSecret": "VITE_FIREBASE_PROJECT_ID"
      },
      {
        "name": "VITE_FIREBASE_APP_ID",
        "fromSecret": "VITE_FIREBASE_APP_ID"
      },
      {
        "name": "VITE_FIREBASE_MESSAGING_SENDER_ID",
        "fromSecret": "VITE_FIREBASE_MESSAGING_SENDER_ID"
      },
      {
        "name": "VITE_FIREBASE_STORAGE_BUCKET",
        "fromSecret": "VITE_FIREBASE_STORAGE_BUCKET"
      },
      {
        "name": "VITE_FIREBASE_MEASUREMENT_ID",
        "fromSecret": "VITE_FIREBASE_MEASUREMENT_ID"
      }
    ]
  }
}
